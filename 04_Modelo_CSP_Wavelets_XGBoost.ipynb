   "source": [
    "## 6. Funciones de evaluación\n",
    "\n",
    "`StratifiedGroupKFold` responde si el modelo generaliza a personas nuevas\n",
    "manteniendo, en lo posible, el balance de clases.\n",
    "`StratifiedKFold` mantiene la proporción de clases al evaluar A1."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "d56639c8",
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_between_subjects(estimator, X, y, groups, n_splits=5):\n",
    "    \"\"\"Evalúa generalización a sujetos que no participaron en entrenamiento.\"\"\"\n",
    "    cv = StratifiedGroupKFold(\n",
    "        n_splits=n_splits, shuffle=True, random_state=RANDOM_STATE\n",
    "    )\n",
    "    scoring = {\"accuracy\": \"accuracy\", \"balanced_accuracy\": \"balanced_accuracy\"}\n",
    "    result = cross_validate(\n",
    "        estimator, X, y, groups=groups, cv=cv, scoring=scoring,\n",
    "        n_jobs=-1, return_train_score=False,\n",
    "    )\n",
    "    return pd.DataFrame({\n",
    "        \"fold\": np.arange(1, n_splits + 1),\n",
    "        \"accuracy\": result[\"test_accuracy\"],\n",
    "        \"balanced_accuracy\": result[\"test_balanced_accuracy\"],\n",
    "    })\n",
    "\n",
    "\n",
    "def evaluate_one_subject(estimator, X, y, groups, subject_id=\"A1\", n_splits=5):\n",
    "    \"\"\"Evalúa un sujeto con folds estratificados, exclusivos y reproducibles.\"\"\"\n",
    "    mask = groups == subject_id\n",
    "    X_subject, y_subject = X[mask], y[mask]\n",
    "    if len(X_subject) == 0:\n",
    "        raise ValueError(f\"No existe el sujeto {subject_id!r}.\")\n",
    "    cv = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=RANDOM_STATE)\n",
    "    predictions = cross_val_predict(\n",
    "        estimator, X_subject, y_subject, cv=cv, n_jobs=-1, method=\"predict\"\n",
    "    )\n",
    "    metrics = pd.Series({\n",
    "        \"Épocas\": len(y_subject),\n",
    "        \"Accuracy\": accuracy_score(y_subject, predictions),\n",
    "        \"Balanced accuracy\": balanced_accuracy_score(y_subject, predictions),\n",
    "    })\n",
    "    return X_subject, y_subject, predictions, metrics"
   ]
  },
