    "# CSP debe ajustarse con datos de entrenamiento; nunca con todo el dataset antes del CV.\n",
    "demo_mask = groups == \"A1\"\n",
    "demo_csp = clone(pipeline.named_steps[\"csp\"]).fit(X[demo_mask], y[demo_mask])\n",
    "demo_features = demo_csp.transform(X[demo_mask][:3])\n",
    "feature_names = [f\"CSP_logvar_{i + 1}\" for i in range(demo_features.shape[1])]\n",
    "display(pd.DataFrame(demo_features, columns=feature_names))\n",
    "print(\"Vector CSP:\", demo_features.shape, \"=> 4 características por época\")"
   ]
