    "def holm_adjust(p_values):\n",
    "    p_values = np.asarray(p_values, dtype=float)\n",
    "    order = np.argsort(p_values)\n",
    "    adjusted_sorted = np.maximum.accumulate(\n",
    "        (len(p_values) - np.arange(len(p_values))) * p_values[order]\n",
    "    )\n",
    "    adjusted = np.empty_like(adjusted_sorted)\n",
    "    adjusted[order] = np.minimum(adjusted_sorted, 1.0)\n",
    "    return adjusted\n",
    "\n",
    "\n",
    "def bootstrap_mean_ci(differences, confidence=0.95, n_resamples=10_000):\n",
    "    rng = np.random.default_rng(RANDOM_STATE)\n",
    "    samples = rng.choice(\n",
    "        differences, size=(n_resamples, len(differences)), replace=True\n",
    "    ).mean(axis=1)\n",
    "    alpha = 1 - confidence\n",
    "    return np.quantile(samples, [alpha / 2, 1 - alpha / 2])\n",
    "\n",
    "\n",
    "baseline = model_columns[0]\n",
    "comparisons = []\n",
    "raw_p_values = []\n",
    "\n",
    "for model in model_columns[1:]:\n",
    "    differences = (\n",
    "        subject_results[model] - subject_results[baseline]\n",
    "    ).dropna().to_numpy()\n",
    "    statistic, p_value = wilcoxon(differences, alternative=\"two-sided\")\n",
    "    ci_low, ci_high = bootstrap_mean_ci(differences)\n",
    "    std_difference = differences.std(ddof=1)\n",
    "    effect_dz = differences.mean() / std_difference if std_difference else np.nan\n",
    "    comparisons.append({\n",
    "        \"Modelo\": model,\n",
    "        \"Diferencia media (pp)\": 100 * differences.mean(),\n",
    "        \"IC95% inferior (pp)\": 100 * ci_low,\n",
    "        \"IC95% superior (pp)\": 100 * ci_high,\n",
    "        \"Wilcoxon W\": statistic,\n",
    "        \"p sin corregir\": p_value,\n",
    "        \"d_z\": effect_dz,\n",
    "    })\n",
    "    raw_p_values.append(p_value)\n",
    "\n",
    "comparison_table = pd.DataFrame(comparisons)\n",
    "comparison_table[\"p Holm\"] = holm_adjust(raw_p_values)\n",
    "comparison_table[\"Significativo (α=0.05)\"] = comparison_table[\"p Holm\"] < 0.05\n",
    "display(comparison_table)"
   ]
