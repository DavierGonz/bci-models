    "def make_pipelines(sfreq):\n",
    "    return {\n",
    "        \"M1: CSP + LDA\": Pipeline([\n",
    "            (\"csp\", CSP(n_components=4, reg=None, log=True, norm_trace=False)),\n",
    "            (\"lda\", LinearDiscriminantAnalysis()),\n",
    "        ]),\n",
    "        \"M2: CSP + PSD + LDA\": Pipeline([\n",
    "            (\"features\", FeatureUnion([\n",
    "                (\"csp\", CSP(n_components=4, reg=None, log=True, norm_trace=False)),\n",
    "                (\"psd\", PSDFeatureExtractor(sfreq=sfreq)),\n",
    "            ])),\n",
    "            (\"lda\", LinearDiscriminantAnalysis()),\n",
    "        ]),\n",
    "        \"M3: CSP + PSD + FOOOF + SVM\": Pipeline([\n",
    "            (\"features\", FeatureUnion([\n",
    "                (\"csp\", CSP(n_components=4, reg=None, log=True, norm_trace=False)),\n",
    "                (\"psd\", PSDFeatureExtractor(sfreq=sfreq)),\n",
    "                (\"fooof\", FOOOFFeatureExtractor(sfreq=sfreq)),\n",
    "            ])),\n",
    "            (\"scaler\", StandardScaler()),\n",
    "            (\"svm\", SVC(kernel=\"rbf\")),\n",
    "        ]),\n",
    "        \"M4: CSP + Wavelets + XGBoost\": Pipeline([\n",
    "            (\"features\", FeatureUnion([\n",
    "                (\"csp\", CSP(n_components=4, reg=None, log=True, norm_trace=False)),\n",
    "                (\"wavelets\", WaveletFeatureExtractor(wavelet=\"db4\", level=4)),\n",
    "            ])),\n",
    "            (\"xgboost\", XGBClassifier(\n",
    "                n_estimators=100,\n",
    "                max_depth=3,\n",
    "                learning_rate=0.1,\n",
    "                eval_metric=\"logloss\",\n",
    "                random_state=RANDOM_STATE,\n",
    "                n_jobs=1,\n",
    "            )),\n",
    "        ]),\n",
    "    }\n",
    "\n",
    "\n",
    "pipelines = make_pipelines(sfreq)\n",
    "pd.Series({\n",
    "    \"M1\": \"4 CSP\",\n",
    "    \"M2\": \"4 CSP + 15 PSD = 19\",\n",
    "    \"M3\": \"4 CSP + 15 PSD + 20 FOOOF = 39\",\n",
    "    \"M4\": \"4 CSP + 25 wavelets = 29\",\n",
    "}, name=\"Vector de características\").to_frame()"
   ]
