    "# La ruta se resuelve desde la carpeta del proyecto o desde BCI_models.\n",
    "candidate_paths = [\n",
    "    Path(\"../data/all_epochs_clean-epo.fif\"),\n",
    "    Path(\"data/all_epochs_clean-epo.fif\"),\n",
    "]\n",
    "epochs_path = next((path for path in candidate_paths if path.exists()), None)\n",
    "if epochs_path is None:\n",
    "    raise FileNotFoundError(\"No se encontró data/all_epochs_clean-epo.fif\")\n",
    "\n",
    "epochs = mne.read_epochs(epochs_path, preload=True, verbose=\"ERROR\")\n",
    "required_channels = [\"Fz\", \"C3\", \"Cz\", \"C4\", \"Pz\"]\n",
    "missing_channels = sorted(set(required_channels) - set(epochs.ch_names))\n",
    "if missing_channels:\n",
    "    raise ValueError(f\"Faltan canales requeridos: {missing_channels}\")\n",
    "epochs.pick(required_channels)\n",
    "\n",
    "if epochs.metadata is None or \"subject\" not in epochs.metadata:\n",
    "    raise ValueError(\"El archivo debe contener metadata con una columna 'subject'.\")\n",
    "\n",
    "# MNE almacena EEG en voltios. Se convierte a microvoltios para que las\n",
    "# características de potencia tengan magnitudes numéricas interpretables.\n",
    "X = epochs.get_data(copy=True) * 1e6\n",
    "y = epochs.events[:, 2]\n",
    "groups = epochs.metadata[\"subject\"].astype(str).to_numpy()\n",
    "sfreq = float(epochs.info[\"sfreq\"])\n",
    "class_names = {code: name for name, code in epochs.event_id.items()}\n",
    "\n",
    "dataset_summary = pd.Series({\n",
    "    \"Épocas\": len(epochs),\n",
    "    \"Sujetos\": len(np.unique(groups)),\n",
    "    \"Canales\": len(epochs.ch_names),\n",
    "    \"Frecuencia (Hz)\": sfreq,\n",
    "    \"Inicio (s)\": epochs.tmin,\n",
    "    \"Fin (s)\": epochs.tmax,\n",
    "})\n",
    "display(dataset_summary.to_frame(\"Valor\"))\n",
    "display(pd.Series(y).map(class_names).value_counts().rename(\"Número de épocas\").to_frame())\n",
