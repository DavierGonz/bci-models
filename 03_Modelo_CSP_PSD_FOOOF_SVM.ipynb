   "source": [
    "## 4. Pipeline completo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "9177a90a",
   "metadata": {},
   "outputs": [],
   "source": [
    "pipeline = Pipeline([\n",
    "    (\"features\", FeatureUnion([\n",
    "        (\"csp\", CSP(n_components=4, reg=None, log=True, norm_trace=False)),\n",
    "        (\"psd\", PSDFeatureExtractor(sfreq=sfreq)),\n",
    "        (\"fooof\", FOOOFFeatureExtractor(sfreq=sfreq)),\n",
    "    ])),\n",
    "    (\"scaler\", StandardScaler()),\n",
    "    (\"svm\", SVC(kernel=\"rbf\")),\n",
    "])"
   ]
  },
