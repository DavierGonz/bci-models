    "## 3. Definición del extractor de características"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "7e2dc434",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "C:\\Users\\User\\AppData\\Local\\Temp\\ipykernel_20168\\455489626.py:43: DeprecationWarning: \n",
      "The `fooof` package is being deprecated and replaced by the `specparam` (spectral parameterization) package.\n",
      "This version of `fooof` (1.1) is fully functional, but will not be further updated.\n",
      "New projects are recommended to update to using `specparam` (see Changelog for details).\n",
      "  from fooof import FOOOF\n"
     ]
    }
   ],
   "source": [
    "from scipy.signal import welch\n",
    "\n",
    "\n",
    "class PSDFeatureExtractor(BaseEstimator, TransformerMixin):\n",
    "    \"\"\"Potencia media de Welch por canal y banda, en orden determinista.\"\"\"\n",
    "\n",
    "    def __init__(self, sfreq=512.0, bands=None, nperseg=256):\n",
    "        self.sfreq = sfreq\n",
    "        self.bands = bands\n",
    "        self.nperseg = nperseg\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        return self\n",
    "\n",
    "    def _bands(self):\n",
    "        return self.bands or (\n",
    "            (\"theta\", 4.0, 8.0),\n",
    "            (\"alpha\", 8.0, 13.0),\n",
    "            (\"beta\", 13.0, 30.0),\n",
    "        )\n",
    "\n",
    "    def transform(self, X):\n",
    "        freqs, psd = welch(\n",
    "            X, fs=self.sfreq, nperseg=min(self.nperseg, X.shape[-1]), axis=-1\n",
    "        )\n",
    "        columns = []\n",
    "        for _, fmin, fmax in self._bands():\n",
    "            mask = (freqs >= fmin) & (freqs < fmax)\n",
    "            if not mask.any():\n",
    "                raise ValueError(f\"No hay bins espectrales entre {fmin} y {fmax} Hz.\")\n",
    "            columns.append(psd[..., mask].mean(axis=-1))\n",
    "        # (épocas, canales, bandas), con las bandas contiguas por canal.\n",
    "        return np.stack(columns, axis=-1).reshape(len(X), -1)\n",
    "\n",
    "    def get_feature_names(self, channel_names):\n",
    "        return [\n",
    "            f\"PSD_{channel}_{band}\"\n",
    "            for channel in channel_names\n",
    "            for band, _, _ in self._bands()\n",
    "        ]\n",
    "\n",
    "\n",
    "from fooof import FOOOF\n",
    "\n",
    "\n",
    "class FOOOFFeatureExtractor(BaseEstimator, TransformerMixin):\n",
    "    \"\"\"Offset, exponente y pico dominante de FOOOF para cada canal.\"\"\"\n",
    "\n",
    "    def __init__(self, sfreq=512.0, freq_range=None, nperseg=512):\n",
    "        self.sfreq = sfreq\n",
    "        self.freq_range = freq_range\n",
    "        self.nperseg = nperseg\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        return self\n",
    "\n",
    "    def transform(self, X):\n",
    "        freq_range = self.freq_range or (1.0, 40.0)\n",
    "        features = np.zeros((len(X), X.shape[1] * 4), dtype=float)\n",
    "        for epoch_idx, epoch in enumerate(X):\n",
    "            freqs, psds = welch(\n",
    "                epoch,\n",
    "                fs=self.sfreq,\n",
    "                nperseg=min(self.nperseg, epoch.shape[-1]),\n",
    "                axis=-1,\n",
    "            )\n",
    "            for channel_idx, psd in enumerate(psds):\n",
    "                model = FOOOF(\n",
    "                    peak_width_limits=(1.0, 8.0),\n",
    "                    max_n_peaks=4,\n",
    "                    min_peak_height=0.1,\n",
    "                    verbose=False,\n",
    "                )\n",
    "                model.fit(freqs, psd, freq_range)\n",
    "                offset, exponent = model.aperiodic_params_[:2]\n",
    "                if len(model.peak_params_):\n",
    "                    peak = model.peak_params_[np.argmax(model.peak_params_[:, 1])]\n",
    "                    peak_frequency, peak_power = peak[:2]\n",
    "                else:\n",
    "                    peak_frequency, peak_power = 0.0, 0.0\n",
    "                start = (epoch_idx * 0) + channel_idx * 4\n",
    "                features[epoch_idx, start:start + 4] = (\n",
    "                    offset, exponent, peak_frequency, peak_power\n",
    "                )\n",
    "        return features\n",
    "\n",
    "    def get_feature_names(self, channel_names):\n",
    "        parameters = (\"offset\", \"exponent\", \"peak_frequency\", \"peak_power\")\n",
    "        return [\n",
    "            f\"FOOOF_{channel}_{parameter}\"\n",
    "            for channel in channel_names\n",
    "            for parameter in parameters\n",
    "        ]"
   ]
  },
